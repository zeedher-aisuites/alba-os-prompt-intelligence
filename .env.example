ALBA_APP_NAME="Alba OS Prompt Intelligence MVP"
ALBA_ENVIRONMENT="development"
ALBA_DEBUG=false
ALBA_DATABASE_URL="postgresql+asyncpg://alba:alba_dev@127.0.0.1:5432/alba_os"
ALBA_TEST_DATABASE_URL="postgresql+asyncpg://alba:alba_dev@127.0.0.1:5432/alba_os_test"
ALBA_DATABASE_ECHO=false
ALBA_DATABASE_POOL_SIZE=5
ALBA_DATABASE_MAX_OVERFLOW=10
ALBA_DATABASE_POOL_TIMEOUT=30
ALBA_DATABASE_POOL_RECYCLE=1800
ALBA_OLLAMA_BASE_URL="http://127.0.0.1:11434"
ALBA_EMBEDDING_MODEL="embeddinggemma:300m"
ALBA_EMBEDDING_TIMEOUT=30
ALBA_EMBEDDING_BATCH_SIZE=16
ALBA_RETRIEVAL_MAX_LIMIT=20

# Docker Compose development defaults. Change these together with ALBA_DATABASE_URL.
ALBA_POSTGRES_USER="alba"
ALBA_POSTGRES_PASSWORD="alba_dev"
ALBA_POSTGRES_DB="alba_os"
ALBA_POSTGRES_PORT=5432
